config privacy 'main'
 option monitor_enabled '0'
 option dns_enabled '0'
 option wan_interface 'auto'
 list lan_interface 'br-lan'
 option resolver_url 'https://223.5.5.5/dns-query'
	option fallback_url 'https://doh.pub/dns-query'
	list fallback_ips '120.53.53.53'
	list fallback_ips '1.12.12.12'
 option dns_port '53535'
 option interval '5'
 option core_adapter '1'
 option disable_offload '1'
 list watch_domain 'google.com'
 list watch_domain 'youtube.com'
 list watch_domain 'github.com'
 list watch_domain 'openai.com'
 list watch_domain 'example.com'

config monitor 'nodes'
 option enabled '0'
 option interval '120'
 option timeout '3000'
 option max_nodes '32'
 option keep_samples '240'
 option persistent '1'
 option api_port '9090'
 option use_openclash '1'
 list targets 'https://www.gstatic.com/generate_204'
 list targets 'https://cp.cloudflare.com/generate_204'

config accounting 'bandwidth'
 option enabled '0'
 option refresh_interval '30'
 option commit_interval '86400'
 option database_directory '/var/lib/neko-smart/bandwidth'
 option database_generations '10'
 option database_interval '1'
 list local_network '192.168.1.0/24'

config reporter 'report'
 option enabled '0'
 option collector_url ''
 option backend_id '1'
 option token ''
 option interval '30'
